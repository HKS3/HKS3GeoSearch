{
    "/biblionumbers": {
        "get": {
            "x-mojo-to": "HKS3::GeoSearch::GeoSearchController#get_biblionumbers",
            "operationId": "GetCoordsByBiblionumbers",
            "tags": ["biblios"],
            "parameters": [{
                "name": "bn",
                "in": "query",
                "description": "id",
                "required": true,
                "type": "array",
                "items": { "type": "integer" },
                "collectionFormat": "multi"
            }],
            "produces": [
                "application/json"
            ],
            "responses": {
                "200": {
                    "description": "List of records matching the given biblio numbers that have coordinates stored in their MARC data",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "data": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "bn": {
                                            "type": "integer",
                                            "description": "The biblio number of the record"
                                        },
                                        "title": {
                                            "type": "string",
                                            "description": "The title of the record, wrapped in an <a> tag pointing to the record in OPAC"
                                        },
                                        "coordinates": {
                                            "type": "array",
                                            "description": "Coordinates that the record describes",
                                            "items": [
                                                { "type": "string", "description": "Latitude" },
                                                { "type": "string", "description": "Longitude" }
                                            ]
                                        }
                                    }
                                }
                            },
                            "count": {
                                "type": "integer",
                                "description": "Number of records returned"
                            }
                        }
                    }
                }
            }
        }
    },
    "/geocode": {
        "get": {
            "x-mojo-to": "HKS3::GeoSearch::GeoSearchController#get_geocode",
            "operationId": "GetGeocode",
            "tags": [],
            "parameters": [
                {
                    "name": "q",
                    "in": "query",
                    "description": "query string",
                    "required": true,
                    "type": "string"
                },
                {
                    "name": "limit",
                    "in": "query",
                    "description": "maximum number of results to return",
                    "required": false,
                    "type": "string"
                }
            ],
            "produces": [
                "application/json"
            ],
            "responses": {
                "200": {
                    "description": "List geocoded places matching the query string",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "places": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "lat": { "type": "string" },
                                        "lng": { "type": "string" },
                                        "name": { "type": "string" },
                                        "countryName": { "type": "string" },
                                        "countryCode": { "type": "string" },
                                        "bbox": {
                                            "type": "object",
                                            "properties": {
                                                "north": { "type": "string" },
                                                "east":  { "type": "string" },
                                                "south": { "type": "string" },
                                                "west":  { "type": "string" }
                                            }
                                        }
                                    }
                                }
                            },
                            "count": {
                                "type": "integer",
                                "description": "Total number of records found"
                            }
                        }
                    }
                }
            }
        }
    }
}
