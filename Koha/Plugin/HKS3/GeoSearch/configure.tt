[% INCLUDE 'doc-head-open.inc' %]
	<title>GeoSearch Plugin Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]

[% leaflet_inc %]
<style>
    #geo_search_map {
		height: 400px;
		width: 600px;
	}
</style>

</head>
<body>

[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="doc3">

	<h3> GeoSearch Plugin Configuration </h3>

	<form method="get">
		<input type="hidden" name="class" value="[% CLASS %]"/>
		<input type="hidden" name="method" value="[% METHOD %]"/>

		<div>
			<label> Language
				<select name="languageCode">
					<option value="en-GB"> en-GB </option>
					<option value="de-AT" [% IF languageCode == 'de-AT' %] selected [% END %]> de-AT </option>
				</select>
			</label>
		</div>

		<div>
			<label> GeoNames username
				<input type="text" name="username" value="[% username %]" />
			</label>
		</div>

		<div>
			<label>
				Default map position (click to set)
				<div id="geo_search_map"></div>
				<label>
					Latitude:
					<input type="text" id="defaultPosition_lat" name="defaultPosition_lat" value="[% defaultPosition_lat %]" />
				</label>
				<label>
					Longitude:
					<input type="text" id="defaultPosition_lon" name="defaultPosition_lon" value="[% defaultPosition_lon %]" />
				</label>
			</label>
			<label>
				Default search radius
	            <input type="text" size="6" name="defaultSearchRadius" pattern="(\d+)(k?m)?" value="[% defaultSearchRadius %]">
			</label>
		</div>

		<div>
			<label> Use Geolocation (if available) for default map position
				<input type="checkbox" name="useGeolocation" [% IF useGeolocation %] checked [% END %] />
			</label>
		</div>

		<div>
			<label>
				Use custom Map settings
				<input type="checkbox" name="useMapConfig" [% IF useMapConfig %] checked [% END %] />
			</label>
			<br>
			<label>
				Map tile URL
				<input type="text" id="mapConfigUrl" name="mapConfigUrl" value="[% mapConfigUrl %]" />
			</label>
			<br>
			<label>
				Leaflet tileLayer options (JSON)
				<textarea id="mapConfigLeafletOpts" name="mapConfigLeafletOpts"> [% mapConfigLeafletOpts | html %] </textarea>
			</label>
			<br>
			<label>
				Maximum initial zoom level when displaying search results
				<input type="text" id="mapConfigMaxInitialResultsZoom" name="mapConfigMaxInitialResultsZoom" value="[% mapConfigMaxInitialResultsZoom %]" />
			</label>
			<button id="mapSettingsPreview" type="button"> Preview </button>
		</div>
		<input type="submit" name="submit" value="Save" />
	</form>
</div>

<script>
	function previewSettings() {
		map.eachLayer(l => map.removeLayer(l));
	    L.tileLayer(
			document.getElementById('mapConfigUrl').value,
			JSON.parse(document.getElementById('mapConfigLeafletOpts').value),
		).addTo(map);
		map.setZoom(document.getElementById('mapConfigMaxInitialResultsZoom').value);
	}
	document.getElementById('mapSettingsPreview').onclick = previewSettings;
    const map = L.map('geo_search_map');
	[% IF defaultPosition_lat && defaultPosition_lon %]
		map.setView([[% defaultPosition_lat %], [% defaultPosition_lon %]], 5);
	[% ELSE %]
		map.setView([48, 13], 5);
	[% END %]
	[% IF useMapConfig %]
	previewSettings();
	[% ELSE %]
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
	[% END %]

	const marker = L.marker([map.getCenter().lat, map.getCenter().lng]);
	marker.addTo(map);

	function updateMarker(pos) {
		marker.setLatLng(pos);
        document.querySelector('input#defaultPosition_lat').value = pos.lat;
        document.querySelector('input#defaultPosition_lon').value = pos.lng;
	}

	map.on('click', (ev) => {
        map.panTo(ev.latlng);
        updateMarker(ev.latlng);
	});

    // When a user manually edits coordinates
    // we update the displayed map
    function onInputUpdated() {
        const lat = document.querySelector('input#defaultPosition_lat').value;
        const lng = document.querySelector('input#defaultPosition_lon').value;
        map.panTo([lat, lng]);
        updateMarker([lat, lng]);
    }
    document.querySelector('input#defaultPosition_lat').addEventListener('input', onInputUpdated);
    document.querySelector('input#defaultPosition_lon').addEventListener('input', onInputUpdated);
</script>
