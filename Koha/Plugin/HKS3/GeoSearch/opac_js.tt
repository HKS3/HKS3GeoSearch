[% USE To %]

const page = $('body').attr('ID');
if (page === 'results') {
    $(document).ready(function() {
        $(".main").prepend('<geosearch-results id="geosearch" />');

        var biblionumbers = [];
        $(".addtocart").each(function() {
            biblionumbers.push( $(this).attr("data-biblionumber") );
        });
        if (biblionumbers.length === 0) {
            document.querySelector('geosearch-results').setAttribute('entries', JSON.stringify({ data: [] }));
        } else {
            $(function(e) {
                var ajaxData = { 'bn': biblionumbers };
                $.ajax({
                    url: '/api/v1/contrib/geo_search/biblionumbers',
                    type: 'GET',
                    dataType: 'json',
                    data: ajaxData,
                    traditional: true
                }).done(function(data) {
                    document.querySelector('geosearch-results').setAttribute('entries', JSON.stringify(data));
                }).error(function(data) {});
            });
        }

        $(document).ready(function() {
            document.getElementById('geosearch').addEventListener('map-moved', (ev) => {
                const bounds = ev.detail.bounds;
                const query = 'boundingbox:' + [
                    bounds.getNorthWest().lat,
                    bounds.getNorthWest().lng,
                    bounds.getSouthEast().lat,
                    bounds.getSouthEast().lng,
                ].join(',');
                document.location.href = '/cgi-bin/koha/opac-search.pl?advsearch=1&idx=geolocation&do=Search&q=' + encodeURI(query);
            });
        });
    });
} else if (page == 'advsearch') {
    const geosearch =`<div class="col-sm-6 col-lg-3">
        <style>
        #geosearch input:invalid {
            border: red solid 3px;
        }
        </style>
        <geosearch-form
            id="geosearch"
            class="advsearch_limit"
            defaultPosition='[% To.json(defaultPosition) %]'
            [% IF useGeolocation %]
            useGeolocation="true"
            [% END %]
        />
    </div>`;

    $("#advsearch_limits").append(geosearch);
}
