[% USE To %]

const page = $('body').attr('ID');
if (page === 'results') {
    $(document).ready(function() {
        const urlParams = new URLSearchParams(window.location.search)
        if (urlParams.get('idx') !== 'geolocation') return;

        $(".main").prepend(`<geosearch-results id="geosearch"
            [% IF mapConfig %]
            mapConfig='[% To.json(mapConfig) %]'
            [% END %]
            [% IF languageCode %]
            languageCode='[% languageCode %]'
            [% END %]
        />`);

        const entries = [];
        for (const record of document.querySelectorAll('span.geolocation')) {
            const bn = record.getAttribute('data-biblionumber');
            const title = `<a href="/cgi-bin/koha/opac-detail.pl?biblionumber=${bn}">${record.getAttribute('data-title')}</a>`;
            const coordinates = JSON.parse(record.getAttribute('data-geolocation')) || [];
            const bounds = JSON.parse(record.getAttribute('data-geolocation-area')) || [];
            for (const coord of coordinates) {
                entries.push({ bn, title, coordinates: coord });
            }
            for (const bbox of bounds) {
                entries.push({ bn, title, bounds: bbox });
            }
        }
        document.querySelector('geosearch-results').setAttribute('entries', JSON.stringify({ data: entries }));

        $(document).ready(function() {
            document.getElementById('geosearch').addEventListener('search-requested', (ev) => {
                const bounds = ev.detail.bounds;
                const query = 'boundingbox:' + [
                    bounds.getNorthWest().lat,
                    bounds.getNorthWest().lng,
                    bounds.getSouthEast().lat,
                    bounds.getSouthEast().lng,
                ].join(',');
                document.location.href = '/cgi-bin/koha/opac-search.pl?advsearch=1&idx=geolocation&do=Search&q=' + encodeURI(query);
            });
        });
    });
} else if (page == 'advsearch') {
    const geosearch =`<div class="col-sm-6 col-lg-3">
        <style>
        #geosearch input:invalid {
            border: red solid 3px;
        }
        </style>
        <geosearch-form
            id="geosearch"
            class="advsearch_limit"
            defaultSearchRadius='[% defaultSearchRadius %]'
            defaultPosition='[% To.json(defaultPosition) %]'
            [% IF useGeolocation %]
            useGeolocation="true"
            [% END %]
            [% IF mapConfig %]
            mapConfig='[% To.json(mapConfig) %]'
            [% END %]
            [% IF languageCode %]
            languageCode='[% languageCode %]'
            [% END %]
        />
    </div>`;

    $("#advsearch_limits").append(geosearch);
}
